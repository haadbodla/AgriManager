rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // SIMPLE TEST RULES - Use these to verify signup works
    // These are TEMPORARY for debugging
    
    match /users/{userId} {
      // Allow authenticated users to read/write their own document
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Allow access to managers subcollection
      match /managers/{managerId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Allow access to all farm data collections
      match /{collection}/{document} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
